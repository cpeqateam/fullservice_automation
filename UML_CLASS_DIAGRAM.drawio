        <!-- ============ BASLIK ============ -->
        <mxCell id="title" value="FULL Servis — Backend Sinif/Modul Diyagrami (her .py dosyasi, degiskenleri ve metotlari)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Renkler:  mavi=giris noktasi   yesil=server paketi   turuncu=agent paketi   sari=common paketi   kirmizi=common/runners (test calistiricilar)&#10;Kesik ok = bagimlilik / import (A --&gt; B : A, B'yi kullanir)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="42" width="1400" height="34" as="geometry" />
        </mxCell>

        <!-- ============ GIRIS NOKTALARI (mavi) ============ -->
        <mxCell id="run_server" value="&#171;giris&#187; run_server.py&#10;────────────────────────────&#10;sys.path.insert(0, ...)  # import yolu&#10;import: uvicorn, server.main(app, CONFIG, orch)&#10;────────────────────────────&#10;__main__:&#10;  host, port = CONFIG[server]&#10;  uvicorn.run(app, host, port)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="run_agent" value="&#171;giris&#187; run_agent.py&#10;────────────────────────────&#10;sys.argv parse →&#10;  env: FS_NODE_ID, FS_SERVER_URL, FS_AGENT_PORT&#10;import: agent.main(app, AGENT_PORT,&#10;  NODE_ID, SERVER_URL, LAN_IP)&#10;────────────────────────────&#10;__main__:&#10;  uvicorn.run(app, host=0.0.0.0, AGENT_PORT)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="100" width="320" height="160" as="geometry" />
        </mxCell>

        <!-- ============ SERVER PAKETI (yesil) ============ -->
        <mxCell id="server_main" value="&#171;FastAPI app&#187; server/main.py&#10;────────────────────────────&#10;CONFIG, orch: Orchestrator, app&#10;_Tee  # stdout/stderr → logs/app.log&#10;class LoginRequest(BaseModel): username, password&#10;class SessionStartRequest(BaseModel):&#10;  modem_ip, internet_ip, youtube_link, duration,&#10;  brand, model, firmware, user_name, user_surname,&#10;  iperf_port, iperf_parallel, iperf_reverse&#10;────────────────────────────&#10;GET  /health&#10;POST /api/login(req)&#10;POST /api/register(req)&#10;POST /api/progress(upd)&#10;POST /api/result(report)&#10;POST /api/logs/upload(node_id, session_id, file)&#10;GET  /api/state&#10;POST /api/session/start(req)&#10;POST /api/session/stop&#10;POST /api/session/reset&#10;GET  /api/health-check&#10;GET  /api/firmware/brands&#10;GET  /api/firmware/models/{brand}&#10;GET  /api/firmware/versions/{brand}/{model}&#10;mount StaticFiles → dashboard (dist/)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="340" height="430" as="geometry" />
        </mxCell>


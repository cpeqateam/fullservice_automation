        <!-- ============ BASLIK ============ -->
        <mxCell id="title" value="FULL Servis — Backend Sinif/Modul Diyagrami (her .py dosyasi, degiskenleri ve metotlari)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Renkler:  mavi=giris noktasi   yesil=server paketi   turuncu=agent paketi   sari=common paketi   kirmizi=common/runners (test calistiricilar)&#10;Kesik ok = bagimlilik / import (A --&gt; B : A, B'yi kullanir)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="42" width="1400" height="34" as="geometry" />
        </mxCell>

        <!-- ============ GIRIS NOKTALARI (mavi) ============ -->
        <mxCell id="run_server" value="&#171;giris&#187; run_server.py&#10;────────────────────────────&#10;sys.path.insert(0, ...)  # import yolu&#10;import: uvicorn, server.main(app, CONFIG, orch)&#10;────────────────────────────&#10;__main__:&#10;  host, port = CONFIG[server]&#10;  uvicorn.run(app, host, port)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">

        <!-- ============ BAGIMLILIK OKLARI ============ -->
        <mxCell id="e1" style="endArrow=open;dashed=1;html=1;strokeColor=#666666;" edge="1" parent="1" source="run_server" target="server_main"><mxGeometry relative="1" as="geometry" /></mxCell>

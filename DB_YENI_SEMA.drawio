        <mxCell id="legend" value="MAVI baslik = ortak cekirdek tablo    YESIL baslik = test sonuc tablosu    PK = birincil anahtar    FK = baska tabloya referans    (yeni) = bu semada eklendi&#10;test_name kolonu: satir GRK'ya mi FULL Servis'e mi ait.    node_name kolonu: FULL Servis'te hangi makine (LINUX/MAC_ETH/MAC_WIFI/WIN_WIFI); GRK'da NULL." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#dddddd;" vertex="1" parent="1">

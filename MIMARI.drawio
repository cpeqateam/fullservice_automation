<mxfile host="app.diagrams.net" agent="fullservice-automation">
  <diagram id="fullservice_arch_v2" name="FULL Servis Mimari (v2)">
    <mxGraphModel dx="1410" dy="777" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#111827" value="FULL Servis — Dağıtık Modem Stres Test Mimarisi" vertex="1">
          <mxGeometry height="30" width="1280" x="60" y="20" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#6B7280" value="Firmware DB (cpeqadb) · Health-Check · Provisioning (statik IP + boot listener) dahil" vertex="1">
          <mxGeometry height="22" width="1280" x="60" y="52" as="geometry" />
        </mxCell>
        <mxCell id="modem" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E20074;strokeColor=#A8005A;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;shadow=1" value="📡 MODEM (CPE)&#xa;&lt;b&gt;Test Altındaki Cihaz&lt;/b&gt;&#xa;Türk Telekom Modem&#xa;LAN: 192.168.1.1" vertex="1">
          <mxGeometry height="90" width="200" x="600" y="90" as="geometry" />
        </mxCell>
        <mxCell id="linux" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#E20074;strokeWidth=2;fontColor=#F9FAFB;fontSize=10;align=left;verticalAlign=top;spacing=10;shadow=1" value="🐧 &lt;b&gt;LINUX SUNUCU&lt;/b&gt;&lt;br&gt;Orkestratör + API host (:8770)&lt;br&gt;&lt;br&gt;&lt;b&gt;Endpoint&#39;ler:&lt;/b&gt;&lt;br&gt;• POST /api/register, /progress&lt;br&gt;• POST /api/logs/upload (multipart)&lt;br&gt;• GET  /api/state (1 sn polling)&lt;br&gt;• POST /api/session/start, /stop, /reset&lt;br&gt;• GET  /api/health-check (aktif probe)&lt;br&gt;• GET  /api/firmware/brands · /models/{b} · /versions/{b}/{m}&lt;br&gt;&lt;br&gt;&lt;b&gt;İçerik:&lt;/b&gt;&lt;br&gt;• Düğüm Registry + Merkezi Aggregator&lt;br&gt;• Yerel testler: ping_modem · ping_internet · youtube&lt;br&gt;• (iperf server kablolu Mac&#39;te)&lt;br&gt;• Log toplama: logs/&amp;lt;BILGISAYAR&amp;gt;/&amp;lt;session&amp;gt;/" vertex="1">
          <mxGeometry height="290" width="290" x="60" y="270" as="geometry" />
        </mxCell>
        <mxCell id="mac_cable" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E1B4B;strokeColor=#5E5CE6;strokeWidth=2;fontColor=#E0E7FF;fontSize=11;align=left;verticalAlign=top;spacing=10;shadow=1" value="🖥️ &lt;b&gt;MAC (Kablo)&lt;/b&gt; = MAC_ETH&#xa;listener (FastAPI) :7531&#xa;&#xa;Testler:&#xa;• ping_modem&#xa;• ping_internet&#xa;• youtube&#xa;• &lt;b&gt;iperf3 -s (SERVER) :5201&lt;/b&gt;" vertex="1">
          <mxGeometry height="230" width="200" x="410" y="270" as="geometry" />
        </mxCell>
        <mxCell id="win_wifi" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0C4A6E;strokeColor=#0EA5E9;strokeWidth=2;fontColor=#E0F2FE;fontSize=11;align=left;verticalAlign=top;spacing=10;shadow=1" value="🪟 &lt;b&gt;WINDOWS (Wi-Fi)&lt;/b&gt; = WIN_WIFI&#xa;listener (FastAPI) :7531&#xa;&#xa;Testler:&#xa;• ping_modem&#xa;• ping_internet&#xa;• youtube&#xa;• torrent (qBittorrent/GTA5)&#xa;• wifi_track" vertex="1">
          <mxGeometry height="230" width="200" x="650" y="270" as="geometry" />
        </mxCell>
        <mxCell id="mac_wifi" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E1B4B;strokeColor=#5E5CE6;strokeWidth=2;fontColor=#E0E7FF;fontSize=11;align=left;verticalAlign=top;spacing=10;shadow=1" value="🖥️ &lt;b&gt;MAC (Wi-Fi)&lt;/b&gt; = MAC_WIFI&#xa;listener (FastAPI) :7531&#xa;&#xa;Testler:&#xa;• ping_modem&#xa;• ping_internet&#xa;• youtube&#xa;• &lt;b&gt;iperf3 -c → kablolu Mac&lt;/b&gt;&#xa;• wifi_track" vertex="1">
          <mxGeometry height="230" width="200" x="890" y="270" as="geometry" />
        </mxCell>
        <mxCell id="browser" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0A84FF;strokeColor=#0050B5;strokeWidth=2;fontColor=#FFFFFF;fontSize=10;align=left;verticalAlign=top;spacing=10;shadow=1" value="🌐 &lt;b&gt;Tarayıcı / Dashboard&lt;/b&gt;&#xa;(Vue 3 + Vuetify 3, Türk Telekom &lt;b&gt;mavi&lt;/b&gt; tema, Inter font)&#xa;&#xa;&lt;b&gt;Bileşenler:&lt;/b&gt;&#xa;• Topbar     → büyük TT logo (tıkla→Panel) + durum + &lt;b&gt;Sıfırla&lt;/b&gt; + tema&#xa;• Sol menü   → Panel / Ayarlar / Profil (son ikisi yer tutucu)&#xa;• DeviceForm → Marka/Model/Firmware + Süre + oturum&amp;ilerleme özeti&#xa;• StatusPanel → Health-Check (aşamalı) + cihaz bilgi ızgarası&#xa;• NodeCard × 4 → orta sütunda &lt;b&gt;2×2&lt;/b&gt; canlı progress&#xa;&#xa;Health-Check planı: 1s×3 → 3s×3 → 5s×3 → 15s → 30s → ∞·60s" vertex="1">
          <mxGeometry height="170" width="430" x="60" y="610" as="geometry" />
        </mxCell>
        <mxCell id="provisioning" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=10;align=left;verticalAlign=top;spacing=10;shadow=1" value="⚙️ &lt;b&gt;PROVISIONING (tek seferlik kurulum)&lt;/b&gt;&#xa;fullservice-backend/provisioning/&#xa;&#xa;Yaptıkları:&#xa;• Statik IP ata (config.json → &lt;b&gt;network.assignments&lt;/b&gt;)&#xa;• Listener&#39;ı boot&#39;ta otomatik başlat (3 platforma özel)&#xa;&#xa;Platform script&#39;leri:&#xa;• macOS   → launchd + com.tt.fullservice.agent.plist&#xa;• Windows → Görev Zamanlayıcı (install-agent-task.ps1)&#xa;• Linux   → systemd (fullservice-server.service)" vertex="1">
          <mxGeometry height="170" width="430" x="510" y="610" as="geometry" />
        </mxCell>
        <mxCell id="cpeqadb" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064E3B;strokeColor=#10B981;strokeWidth=2;fontColor=#D1FAE5;fontSize=10;align=left;verticalAlign=top;spacing=10;shadow=1" value="🗄️ &lt;b&gt;cpeqadb&lt;/b&gt; (uzak)&#xa;PostgreSQL · SSL verify-ca&#xa;&#xa;Tablo: &lt;b&gt;grk_firmware&lt;/b&gt;&#xa;&#xa;Marka / Model /&#xa;Firmware listesi&#xa;&#xa;Sertifikalar:&#xa;backend/certs/&#xa;(repoya konulmaz)" vertex="1">
          <mxGeometry height="170" width="200" x="960" y="610" as="geometry" />
        </mxCell>
        <mxCell id="e_modem_linux" edge="1" parent="1" source="modem" style="endArrow=none;html=1;strokeColor=#10B981;strokeWidth=3;fontColor=#065F46;fontSize=10;fontStyle=1" target="linux" value="Kablo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_modem_mac_cable" edge="1" parent="1" source="modem" style="endArrow=none;html=1;strokeColor=#10B981;strokeWidth=3;fontColor=#065F46;fontSize=10;fontStyle=1" target="mac_cable" value="Kablo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_modem_win" edge="1" parent="1" source="modem" style="endArrow=none;html=1;dashed=1;dashPattern=6 6;strokeColor=#5E5CE6;strokeWidth=3;fontColor=#3730A3;fontSize=10;fontStyle=1" target="win_wifi" value="Wi-Fi">
          <mxGeometry relative="1" as="geometry" />

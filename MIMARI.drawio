        <mxCell id="e_browser_linux" edge="1" parent="1" source="browser" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#0A84FF;strokeWidth=2;fontColor=#0050B5;fontSize=10;fontStyle=1" target="linux" value="GET /api/state (1 sn polling)&#xa;POST /api/session/start, /stop&#xa;GET /api/health-check (aşamalı)&#xa;GET /api/firmware/* (combobox)">
          <mxGeometry relative="1" as="geometry" />

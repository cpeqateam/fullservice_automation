        <mxCell id="e_http_mac_cable" edge="1" parent="1" source="linux" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#6B7280;strokeWidth=1.5;dashed=1;dashPattern=2 2;fontSize=9;fontColor=#374151;exitX=1;exitY=0.65;entryX=0;entryY=0.5" target="mac_cable" value="HTTP /api/*&#xa;register · progress&#xa;/start · /logs/upload&#xa;/health (sunucudan probe)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_http_win" edge="1" parent="1" source="linux" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#6B7280;strokeWidth=1.5;dashed=1;dashPattern=2 2;fontSize=9;fontColor=#374151;exitX=1;exitY=0.8;entryX=0;entryY=0.7" target="win_wifi" value="HTTP /api/*">
          <mxGeometry relative="1" as="geometry" />

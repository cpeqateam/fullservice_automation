        <mxCell id="e_linux_db" edge="1" parent="1" source="linux" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#10B981;strokeWidth=2;fontColor=#065F46;fontSize=10;fontStyle=1" target="cpeqadb" value="SQL · SSL verify-ca&#xa;SELECT brand/model/version&#xa;FROM grk_firmware">

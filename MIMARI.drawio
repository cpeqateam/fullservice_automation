<mxfile host="app.diagrams.net" agent="fullservice-automation" version="24.0.0">
  <diagram id="fullservice_arch" name="FULL Servis Mimari">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============= TITLE ============= -->
        <mxCell id="title" value="FULL Servis — Dağıtık Modem Stres Test Mimarisi" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#111827" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="1120" height="30" as="geometry" />
        </mxCell>

        <!-- ============= MODEM ============= -->
        <mxCell id="modem" value="📡 MODEM (CPE)&#xa;&lt;b&gt;Test Altındaki Cihaz&lt;/b&gt;&#xa;Türk Telekom Modem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E20074;strokeColor=#A8005A;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;shadow=1" vertex="1" parent="1">
          <mxGeometry x="520" y="70" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- ============= LINUX SUNUCU (Orkestratör) ============= -->
        <mxCell id="linux" value="🐧 &lt;b&gt;LINUX SUNUCU&lt;/b&gt;&#xa;(Orkestratör + Beyin)&#xa;&#xa;• FastAPI :8770&#xa;• Düğüm Registry + Aggregator&#xa;• Fan-out → POST /start&#xa;• iperf3 server :5201&#xa;• Yerel testler:&#xa;   ping_modem · ping_internet · youtube&#xa;• Log toplama:&#xa;   logs/&amp;lt;session&amp;gt;/&amp;lt;node&amp;gt;/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#E20074;strokeWidth=2;fontColor=#F9FAFB;fontSize=11;align=left;verticalAlign=top;spacing=10;shadow=1" vertex="1" parent="1">
          <mxGeometry x="60" y="240" width="260" height="240" as="geometry" />
        </mxCell>

        <!-- ============= MAC (Kablo) AGENT ============= -->
        <mxCell id="mac_cable" value="🖥️ &lt;b&gt;MAC (Kablo)&lt;/b&gt;&#xa;agent :8771&#xa;&#xa;Testler:&#xa;• ping_modem&#xa;• ping_internet&#xa;• youtube&#xa;• iperf3 -c → sunucu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E1B4B;strokeColor=#5E5CE6;strokeWidth=2;fontColor=#E0E7FF;fontSize=11;align=left;verticalAlign=top;spacing=10;shadow=1" vertex="1" parent="1">
          <mxGeometry x="380" y="240" width="200" height="220" as="geometry" />
        </mxCell>

        <!-- ============= WINDOWS (Wi-Fi) AGENT ============= -->
        <mxCell id="win_wifi" value="🪟 &lt;b&gt;WINDOWS (Wi-Fi)&lt;/b&gt;&#xa;agent :8771&#xa;&#xa;Testler:&#xa;• ping_modem&#xa;• ping_internet&#xa;• youtube&#xa;• torrent&#xa;• wifi_track" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0C4A6E;strokeColor=#0EA5E9;strokeWidth=2;fontColor=#E0F2FE;fontSize=11;align=left;verticalAlign=top;spacing=10;shadow=1" vertex="1" parent="1">
          <mxGeometry x="620" y="240" width="200" height="220" as="geometry" />
        </mxCell>

        <!-- ============= MAC (Wi-Fi) AGENT ============= -->
        <mxCell id="mac_wifi" value="🖥️ &lt;b&gt;MAC (Wi-Fi)&lt;/b&gt;&#xa;agent :8771&#xa;&#xa;Testler:&#xa;• ping_modem&#xa;• ping_internet&#xa;• youtube&#xa;• iperf3 -c → sunucu&#xa;• wifi_track" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E1B4B;strokeColor=#5E5CE6;strokeWidth=2;fontColor=#E0E7FF;fontSize=11;align=left;verticalAlign=top;spacing=10;shadow=1" vertex="1" parent="1">
          <mxGeometry x="860" y="240" width="200" height="220" as="geometry" />
        </mxCell>

        <!-- ============= BROWSER / DASHBOARD ============= -->
        <mxCell id="browser" value="🌐 &lt;b&gt;Tarayıcı&lt;/b&gt;&#xa;(Vue 3 + Vuetify Dashboard)&#xa;&#xa;• 1 sn polling GET /api/state&#xa;• POST /api/session/start, /stop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0A84FF;strokeColor=#0050B5;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;align=left;verticalAlign=top;spacing=10;shadow=1" vertex="1" parent="1">
          <mxGeometry x="60" y="540" width="260" height="110" as="geometry" />
        </mxCell>

        <!-- ============= FAZ 5 (LOG → FTPS + DB) ============= -->
        <mxCell id="faz5" value="🔒 &lt;b&gt;Faz 5 — Kalıcılık (planlanan)&lt;/b&gt;&#xa;&#xa;logs/&amp;lt;session&amp;gt;/  →  FTPS sunucu  +  PostgreSQL (SSL)  +  Mail (SMTP)  +  Telegram Bot&#xa;Tüm kimlik bilgileri .env / ortam değişkeniyle, repoda asla commit'lenmez." style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=1;fontColor=#374151;fontSize=11;align=left;verticalAlign=middle;spacing=10" vertex="1" parent="1">
          <mxGeometry x="380" y="540" width="680" height="110" as="geometry" />
        </mxCell>

        <!-- ============= LEGEND ============= -->
        <mxCell id="legend" value="&lt;b&gt;Lejant&lt;/b&gt;&#xa;━━━ Kablo (Ethernet)    - - - Wi-Fi    ━━━ HTTP /api/* (LAN)" style="text;html=1;fontSize=11;align=left;fontColor=#374151" vertex="1" parent="1">
          <mxGeometry x="60" y="690" width="1000" height="40" as="geometry" />
        </mxCell>

        <!-- ============= EDGES — Fiziksel link (Modem ↔ Düğümler) ============= -->
        <!-- Modem → Linux (kablo) -->
        <mxCell id="e_modem_linux" value="Kablo" style="endArrow=none;html=1;strokeColor=#10B981;strokeWidth=3;fontColor=#065F46;fontSize=10;fontStyle=1" edge="1" parent="1" source="modem" target="linux">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Modem → Mac kablo -->
        <mxCell id="e_modem_mac_cable" value="Kablo" style="endArrow=none;html=1;strokeColor=#10B981;strokeWidth=3;fontColor=#065F46;fontSize=10;fontStyle=1" edge="1" parent="1" source="modem" target="mac_cable">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Modem → Win Wi-Fi (dashed) -->
        <mxCell id="e_modem_win" value="Wi-Fi" style="endArrow=none;html=1;dashed=1;dashPattern=6 6;strokeColor=#5E5CE6;strokeWidth=3;fontColor=#3730A3;fontSize=10;fontStyle=1" edge="1" parent="1" source="modem" target="win_wifi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Modem → Mac Wi-Fi (dashed) -->
        <mxCell id="e_modem_mac_wifi" value="Wi-Fi" style="endArrow=none;html=1;dashed=1;dashPattern=6 6;strokeColor=#5E5CE6;strokeWidth=3;fontColor=#3730A3;fontSize=10;fontStyle=1" edge="1" parent="1" source="modem" target="mac_wifi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============= EDGES — HTTP /api/* (Linux ↔ Agent'lar) ============= -->
        <mxCell id="e_http_mac_cable" value="HTTP /api/*&#xa;(register, progress,&#xa;/start, /logs/upload)" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#6B7280;strokeWidth=1.5;dashed=1;dashPattern=2 2;fontSize=9;fontColor=#374151;exitX=1;exitY=0.7;entryX=0;entryY=0.7" edge="1" parent="1" source="linux" target="mac_cable">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_http_win" value="HTTP /api/*" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#6B7280;strokeWidth=1.5;dashed=1;dashPattern=2 2;fontSize=9;fontColor=#374151;exitX=1;exitY=0.85;entryX=0;entryY=0.85" edge="1" parent="1" source="linux" target="win_wifi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_http_mac_wifi" value="HTTP /api/*" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#6B7280;strokeWidth=1.5;dashed=1;dashPattern=2 2;fontSize=9;fontColor=#374151;exitX=1;exitY=0.95;entryX=0;entryY=0.95" edge="1" parent="1" source="linux" target="mac_wifi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============= EDGE — Browser ↔ Linux (dashboard) ============= -->
        <mxCell id="e_browser_linux" value="GET /api/state (1 sn polling)&#xa;POST /api/session/start, /stop" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#0A84FF;strokeWidth=2;fontColor=#0050B5;fontSize=10;fontStyle=1" edge="1" parent="1" source="browser" target="linux">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============= EDGE — Linux → Faz 5 (dashed) ============= -->
        <mxCell id="e_linux_faz5" value="oturum sonu: log paketle → gönder" style="endArrow=classic;html=1;dashed=1;dashPattern=4 4;strokeColor=#9CA3AF;strokeWidth=1.5;fontColor=#6B7280;fontSize=10;fontStyle=2" edge="1" parent="1" source="linux" target="faz5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

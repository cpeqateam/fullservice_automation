        <mxCell id="e_http_mac_wifi" edge="1" parent="1" source="linux" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#6B7280;strokeWidth=1.5;dashed=1;dashPattern=2 2;fontSize=9;fontColor=#374151;exitX=1;exitY=0.92;entryX=0;entryY=0.9" target="mac_wifi" value="HTTP /api/*">
          <mxGeometry relative="1" as="geometry" />
